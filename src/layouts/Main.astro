---
import "../styles/global.css";
import "@fw-vision/web-kit/styles/tokens.css";
import "@fw-vision/web-kit/styles/annotation-tokens.css";
import Wordmark from "../components/Wordmark.astro";

export interface Props {
  title: string;
  description?: string;
  activePath?: string;
  /** When true, the nav starts transparent over a dark hero and turns solid on scroll. */
  heroNav?: boolean;
}

const {
  title,
  description = "DAI Compute. The procurement place for Canadian energy and AI compute capacity. Financed through financial partners, managed by DAI Compute.",
  activePath = "",
  heroNav = false,
} = Astro.props;

const navLinks = [
  { label: "Invest", href: "/invest" },
  { label: "Buy", href: "/buy" },
  { label: "Build", href: "/build" },
  { label: "Technology", href: "/technology" },
  { label: "Sovereignty", href: "/sovereignty" },
  { label: "About", href: "/about" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class:list={["antialiased", heroNav && "has-hero"]}>
    <header
      id="site-header"
      data-hero-nav={heroNav ? "true" : "false"}
      class:list={[
        "fixed inset-x-0 top-0 z-50 transition-colors duration-300",
        heroNav ? "is-hero" : "is-solid",
      ]}
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10">
        <a href="/" class="site-brand" aria-label="DAI Compute home">
          <Wordmark variant="nav" class="text-lg" />
        </a>
        <nav class="hidden items-center gap-7 lg:flex">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="nav-link text-sm transition-colors"
                aria-current={activePath === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <a href="/contact" class="btn-primary hidden px-5 py-2.5 text-xs font-medium uppercase tracking-[0.14em] lg:inline-block">
          Register interest
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-hairline">
      <div class="tech-grid">
        <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
          <div class="flex flex-col justify-between gap-10 md:flex-row">
            <div class="max-w-sm">
              <span class="font-display text-2xl font-semibold tracking-tight">
                <span style="color: var(--color-orange);">DAI</span> Compute
              </span>
              <p class="mt-4 text-sm leading-relaxed text-slate">
                The procurement place for Canadian energy and AI compute
                capacity. Traditional partner financing and commercial purchase
                first. Capacity managed by DAI Compute.
              </p>
              <p class="field-note mt-5 text-slate/70">
                Built in Canada. Backed by Canadian assets. Owned and operated
                under Canadian law.
              </p>
            </div>
            <nav class="flex flex-col gap-2.5 text-sm text-slate">
              <a href="/invest" class="transition-colors hover:text-snow">Invest</a>
              <a href="/buy" class="transition-colors hover:text-snow">Buy</a>
              <a href="/build" class="transition-colors hover:text-snow">Build</a>
              <a href="/technology" class="transition-colors hover:text-snow">Technology</a>
              <a href="/sovereignty" class="transition-colors hover:text-snow">Sovereignty</a>
              <a href="/future" class="transition-colors hover:text-snow">The Future</a>
              <a href="/about" class="transition-colors hover:text-snow">About</a>
              <a href="/contact" class="transition-colors hover:text-snow">Contact</a>
            </nav>
          </div>
          <div class="mt-12 flex flex-col justify-between gap-4 border-t border-hairline pt-6 md:flex-row">
            <p class="field-note text-slate/60">
              &copy; {year} DAI Compute. Backing Canadian economic sovereignty.
            </p>
            <p class="field-note text-slate/50">
              Pre-launch. No financial product is offered. Not investment advice.
            </p>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const header = document.getElementById("site-header");
        if (!header || header.dataset.heroNav !== "true") return;
        const threshold = 120;
        const sync = () => {
          if (window.scrollY > threshold) header.classList.add("scrolled");
          else header.classList.remove("scrolled");
        };
        sync();
        window.addEventListener("scroll", sync, { passive: true });
      })();
    </script>
  </body>
</html>
