---
import Main from "@/layouts/Main.astro";
import PageHeader from "@/components/PageHeader.astro";
import StepCard from "@/components/StepCard.astro";
import FeatureCard from "@/components/FeatureCard.astro";
---

<Main
  title="Build: Host and expand Canadian energy and compute"
  description="Expand Canadian energy and compute capacity at qualifying sites. Financial partners may assess financing or lease-to-own after feasibility. Capacity managed by DAI Compute."
  activePath="/build"
>
  <PageHeader
    eyebrow="Build"
    title="Host and expand Canadian capacity."
    lede="Qualifying sites and builders expand distributed energy and compute. Financial partners may assess financing options or lease-to-own after feasibility and underwriting. Capacity is managed by DAI Compute with qualified suppliers and operators."
  />

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <p class="field-label" style="color: var(--color-yellow);">How it works</p>
    <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
      Feasibility first. Financing second. No promised rates.
    </h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <StepCard index="01" title="Screen the site">
        Commercial and industrial sites may be assessed for a right-sized compute
        installation that serves external demand and optional internal workloads.
      </StepCard>
      <StepCard index="02" title="Design the capacity">
        Solar, battery, and compute are engineered as separate assets before any
        combined offer. Electrical, safety, network, and operating limits matter.
      </StepCard>
      <StepCard index="03" title="Assess partner financing">
        Independent financial partners may evaluate financing or lease-to-own
        after feasibility. Approval, rates, terms, and ownership transfer are
        partner- and transaction-specific. DAI Compute does not currently offer
        financing as a live product.
      </StepCard>
    </div>
  </section>

  <section class="border-y border-hairline bg-ink-2/30">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="field-label" style="color: var(--color-yellow);">Who builds</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
        From a capacity host to a commercial micro-datacentre.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <FeatureCard kicker="Capacity host" title="Site partner" accent="yellow">
          Factories, warehouses, farms, greenhouses, and other C&amp;I operators
          may host right-sized compute capacity for external buyers, with
          optional internal use.
        </FeatureCard>
        <FeatureCard kicker="Energy operator" title="Higher-value load" accent="yellow">
          Co-locate compute with generation so electrons serve Canadian AI
          capacity under Canadian coordination, not only wholesale export.
        </FeatureCard>
        <FeatureCard kicker="Developer" title="Dedicated deployment" accent="yellow">
          Customer-site or commercial micro-datacentre paths for organizations
          that need dedicated capacity with an agreed service model.
        </FeatureCard>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <div class="max-w-3xl">
      <p class="field-label" style="color: var(--color-yellow);">Where we are</p>
      <h2 class="mt-4 font-display text-2xl font-semibold leading-tight tracking-tight text-snow sm:text-3xl">
        Pilot cohort. Register for a capacity-host screen.
      </h2>
      <p class="mt-5 text-base leading-relaxed text-slate">
        Near-term goal: first pilot sites with real hardware, real generation,
        and real compute. We do not publish host economics, utilisation
        guarantees, or loan approvals. Affiliates and suppliers are engaged
        privately; they are not named as public partners on this site.
      </p>
      <a href="/contact" class="btn-primary mt-8 inline-flex items-center px-7 py-3.5 text-sm">
        Request a capacity-host screen
      </a>
    </div>
  </section>
</Main>
