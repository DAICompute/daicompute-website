---
import Main from "@/layouts/Main.astro";
import StatCounter from "@/components/StatCounter.astro";
import StepCard from "@/components/StepCard.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import TokenCard from "@/components/TokenCard.astro";
import GridDemo from "@/components/GridDemo.astro";
import { ForesightScope } from "@fw-vision/widgets";
import "@fw-vision/widgets/style.css";
import { sovereigntyForesightData } from "@/data/foresight";
---

<Main
  title="DAI Compute - Invest in and build Canadian sovereign compute"
  description="The method for Canadians to invest in, borrow against, and build Canadian energy and AI compute infrastructure. Asset-backed, verifiable, sovereign by law. Blockchain sovereign compute."
  activePath="/"
  heroNav={true}
>
  <!-- Hero -->
  <section class="hero-glow relative overflow-hidden border-b border-hairline">
    <div class="tech-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-7xl px-6 pb-24 pt-40 sm:pt-48 lg:px-10 lg:pb-28">
      <p class="field-label" style="color: var(--color-orange);">
        Blockchain sovereign compute &middot; Canada
      </p>
      <h1 class="mt-8 max-w-4xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-snow sm:text-5xl lg:text-[4.25rem]">
        How Canadians can build Canadian
        <span class="text-energy"> energy and compute.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-mist">
        DAI Compute is a two-sided credit protocol. Depositors earn yield from
        building Canadian infrastructure. Builders borrow against the energy and
        compute they build. Every position is backed by physical Canadian
        assets, verifiable on-chain, and sovereign by law.
      </p>
      <div class="mt-11 flex flex-wrap items-center gap-5">
        <a href="/invest" class="btn-primary inline-flex items-center px-7 py-3.5 text-sm">
          Invest for yield
        </a>
        <a href="/build" class="btn-ghost inline-flex items-center px-7 py-3.5 text-sm">
          Borrow to build
        </a>
      </div>

      <!-- Verified national context (NOT live protocol metrics; pre-CSA) -->
      <div class="mt-20 border-t border-hairline pt-10">
        <p class="field-label mb-6 text-slate">The Canadian opportunity, in verified numbers</p>
        <StatCounter
          stats={[
            { value: "0", label: "Canadian systems in the global top 50", source: "TOP500, Nov 2024" },
            { value: "$0.05", label: "per kWh industrial power, Quebec", source: "Hydro-Quebec" },
            { value: "140,000+", label: "AI professionals excluded from public compute", source: "Budget 2024" },
            { value: "~100:1", label: "US to Canada sovereign-compute investment", source: "CHIPS Act vs. Budget 2024" },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- The gap -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="field-label" style="color: var(--color-orange);">The gap</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
          The energy and the talent exist. The financing mechanism does not.
        </h2>
      </div>
      <div class="max-w-2xl space-y-5 text-base leading-relaxed text-slate">
        <p>
          Canada spent $705M on one centralised supercomputer for academic
          researchers. There is no mechanism for the 140,000 professionals in
          industry, the startups, the energy companies, or the citizens to
          finance and profit from building sovereign compute.
        </p>
        <p>
          So capital and talent flow abroad, the cheapest clean energy in the
          G7 powers foreign-owned data centres, and every Canadian business on a
          foreign cloud carries CLOUD Act exposure. DAI Compute is the credit
          market that connects Canadian capital to Canadian infrastructure.
        </p>
        <a href="/sovereignty" class="accent-link field-note inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
          The problem we solve
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- The demonstration -->
  <section class="border-y border-hairline bg-ink-2/30">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
      <p class="field-label" style="color: var(--color-orange);">The thesis, visualised</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
        Centralised serves a few. Distributed builds sovereign capacity everywhere.
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate">
        Watch the two models alternate, or select one. Centralised compute
        concentrates in one location; distributed DAI Compute lights up nodes
        coast to coast, powered by Canadian energy, owned by Canadians.
      </p>
      <div class="mt-10">
        <GridDemo />
      </div>
      <p class="field-note mt-4 text-slate/60">
        Schematic interim, auto-cycling. The full interactive geographic
        demonstration (choropleth map of Canada, energy and data-centre assets,
        sovereign vs US-owned) is a visual-tooling build; see the handoff plan.
      </p>
    </div>
  </section>

  <!-- Two-sided market -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
    <p class="field-label" style="color: var(--color-orange);">A two-sided market</p>
    <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
      One side supplies capital. The other side builds.
    </h2>
    <div class="mt-14 grid gap-6 md:grid-cols-2">
      <div class="card-lift flex flex-col border border-hairline bg-ink-2/60 p-8">
        <span class="field-label" style="color: var(--color-orange);">Invest</span>
        <h3 class="mt-3 font-display text-2xl font-semibold text-snow">Earn yield from building Canadian infrastructure.</h3>
        <p class="mt-4 text-sm leading-relaxed text-slate">
          Deposit into <span class="ticker text-mist">CADS</span>, an
          algorithmically stabilised synthetic Canadian dollar. Stake for
          <span class="ticker text-mist">sCADS</span> and earn yield drawn from
          real energy and compute loans, not token subsidies. Reserve composition
          and valuation methods are disclosed.
        </p>
        <a href="/invest" class="accent-link field-note mt-6 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
          How investing works <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="card-lift flex flex-col border border-hairline bg-ink-2/60 p-8">
        <span class="field-label" style="color: var(--color-yellow);">Build</span>
        <h3 class="mt-3 font-display text-2xl font-semibold text-snow">Borrow against the infrastructure you build.</h3>
        <p class="mt-4 text-sm leading-relaxed text-slate">
          Non-recourse financing for Canadian energy and compute hardware,
          secured by the assets and their cashflows. Zero-down paths for node
          operators; institutional facilities for energy companies and
          data-centre developers.
        </p>
        <a href="/build" class="accent-link field-note mt-6 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]" style="color: var(--color-yellow);">
          How building works <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why it holds: feature grid -->
  <section class="border-t border-hairline bg-ink-2/30">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
      <p class="field-label" style="color: var(--color-orange);">Why it holds</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
        Backed by the physical backbone of Canadian AI.
      </h2>
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <FeatureCard kicker="Asset-backed" title="Backed by real assets">
          Every position is collateralised by physical Canadian infrastructure:
          solar, batteries, and compute hardware. Not fiat volatility, not
          token speculation.
        </FeatureCard>
        <FeatureCard kicker="Verifiable" title="Proof of reserves">
          View treasury assets, loans, and collateral on-chain at any time. An
          authoritative on-chain lender register, not private reports.
        </FeatureCard>
        <FeatureCard kicker="Sovereign" title="Canadian jurisdiction" accent="red">
          Assets on Canadian soil under Canadian jurisdiction. Free of CLOUD Act
          exposure. Sovereignty is the collateral and the moat.
        </FeatureCard>
        <FeatureCard kicker="Complementary" title="Alongside the government">
          Private capital mobilised alongside the federal programme, not against
          it. The market mechanism public funding alone cannot provide.
        </FeatureCard>
      </div>
    </div>
  </section>

  <!-- Token teaser -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
    <p class="field-label" style="color: var(--color-orange);">The instrument stack</p>
    <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
      Three instruments. One stable unit of account.
    </h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <TokenCard
        symbol="CADS"
        name="Synthetic dollar"
        tagline="Algorithmic stablecoin. Stabilised against CAD over a blended reserve. The stable entry point; does not accrue yield."
        attributes={[
          { k: "Type", v: "Algorithmic stablecoin" },
          { k: "Peg", v: "Tracks CAD (algorithmic)" },
          { k: "Reserve", v: "Blended, multi-method valued" },
          { k: "Yield", v: "None (liquid unit)" },
        ]}
      />
      <TokenCard
        symbol="sCADS"
        name="Staked yield"
        tagline="Stake CADS to earn from the infrastructure loan book and idle-reserve T-bills."
        accent="yellow"
        attributes={[
          { k: "Yield", v: "Loan interest + T-bills" },
          { k: "Mechanism", v: "Rising exchange rate" },
          { k: "Redeem", v: "Epoch queue (Northern Queue)" },
        ]}
      />
      <TokenCard
        symbol="CROWN"
        name="Governance"
        tagline="Governs collateral standards, loan-to-value tiers, fees, and how the network expands."
        accent="red"
        attributes={[
          { k: "Role", v: "Protocol governance" },
          { k: "Staking", v: "sCROWN backstop" },
          { k: "Escrow", v: "veCROWN (considered)" },
        ]}
      />
    </div>
    <p class="field-note mt-6 text-slate/60">
      Token names are candidates pending trademark and ticker validation. See the protocol page.
    </p>
  </section>

  <!-- The future teaser -->
  <section class="hero-glow relative overflow-hidden border-y border-hairline bg-ink-2/40">
    <div class="tech-grid absolute inset-0 opacity-70"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-24 lg:px-10">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="field-label" style="color: var(--color-orange);">The long horizon</p>
          <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
            The first vehicle on a fifty-year journey.
          </h2>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-mist">
            By 2080, up to 3.7 billion people may live outside the human climate
            niche. Canada sits in the temperature zone people will move toward.
            Sovereign energy and compute is the settlement foundation for the
            Canada that is arriving.
          </p>
          <a href="/future" class="accent-link field-note mt-7 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
            See the fifty-year trajectory <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="border border-hairline bg-ink-2 aspect-[4/3]">
          <ForesightScope
            client:only="react"
            theme="dark"
            showLegend={false}
            compact
            data={sovereigntyForesightData}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-6 py-24 text-center lg:px-10">
    <p class="field-label" style="color: var(--color-orange);">Join the first cohort</p>
    <h2 class="mx-auto mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
      Back Canadian economic sovereignty.
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-slate">
      DAI Compute is in its early stages, pre-regulatory clarity. Register your
      interest to invest, build, or partner.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-5">
      <a href="/contact" class="btn-primary inline-flex items-center px-7 py-3.5 text-sm">Register interest</a>
      <a href="/protocol" class="btn-ghost inline-flex items-center px-7 py-3.5 text-sm">Read the protocol</a>
    </div>
  </section>
</Main>
