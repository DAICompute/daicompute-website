---
import Main from "@/layouts/Main.astro";
import StatCounter from "@/components/StatCounter.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import GridDemo from "@/components/GridDemo.astro";
import { ForesightScope } from "@fw-vision/widgets";
import "@fw-vision/widgets/style.css";
import { sovereigntyForesightData } from "@/data/foresight";
---

<Main
  title="DAI Compute: Procure Canadian energy and compute capacity"
  description="DAI Compute is the procurement place for Canadian energy and AI compute capacity. Financial partners, commercial compute purchase, and managed Canadian capacity."
  activePath="/"
  heroNav={true}
>
  <!-- Hero -->
  <section class="hero-glow relative overflow-hidden border-b border-hairline">
    <div class="tech-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-7xl px-6 pb-24 pt-40 sm:pt-48 lg:px-10 lg:pb-28">
      <p class="field-label" style="color: var(--color-orange);">
        Canadian energy and compute capacity
      </p>
      <h1 class="mt-8 max-w-4xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-snow sm:text-5xl lg:text-[4.25rem]">
        How Canadians procure Canadian
        <span class="text-energy"> energy and compute.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-mist">
        DAI Compute is the procurement place where capital and customers connect
        to Canadian energy and AI compute capacity. Traditional paths lead:
        financial partners for financing and lease-to-own pathways, commercial
        purchase of compute and compute credits, and hosts expanding capacity.
        Capacity is managed by DAI Compute.
      </p>
      <div class="mt-11 flex flex-wrap items-center gap-5">
        <a href="/invest" class="btn-primary inline-flex items-center px-7 py-3.5 text-sm">
          Invest in capacity
        </a>
        <a href="/buy" class="btn-ghost inline-flex items-center px-7 py-3.5 text-sm">
          Buy compute
        </a>
      </div>

      <div class="mt-20 border-t border-hairline pt-10">
        <p class="field-label mb-6 text-slate">The Canadian opportunity, in verified numbers</p>
        <StatCounter
          stats={[
            { value: "0", label: "Canadian systems in the global top 50", source: "TOP500, Nov 2024" },
            { value: "$0.05", label: "per kWh industrial power, Quebec", source: "Hydro-Quebec" },
            { value: "140,000+", label: "AI professionals excluded from public compute", source: "Budget 2024" },
            { value: "~100:1", label: "US to Canada sovereign-compute investment", source: "CHIPS Act vs. Budget 2024" },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- The gap -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="field-label" style="color: var(--color-orange);">The gap</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
          The energy and the talent exist. The procurement place does not.
        </h2>
      </div>
      <div class="max-w-2xl space-y-5 text-base leading-relaxed text-slate">
        <p>
          Canada spent $705M on one centralized supercomputer for academic
          researchers. There is no clear place for industry, startups, energy
          companies, hosts, or infrastructure capital to finance and buy
          Canadian energy and compute capacity together.
        </p>
        <p>
          So capital and talent flow abroad, the cheapest clean energy in the
          G7 powers foreign-owned data centres, and Canadian businesses on
          foreign-operated cloud face residency and control questions, including
          where U.S. law may reach data held by U.S.-linked providers. DAI
          Compute is the procurement place that connects Canadian capital to
          Canadian capacity.
        </p>
        <a href="/sovereignty" class="accent-link field-note inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
          The problem we solve
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Canada2080 -->
  <section class="border-y border-hairline bg-ink-2/30">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
      <p class="field-label" style="color: var(--color-orange);">Infrastructure interest</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
        Interest in Canadian infrastructure is rising. We help turn it into capacity.
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate">
        Initiatives such as
        <a href="https://canada2080.org" class="accent-link">Canada2080</a>
        rally interest in investing in Canadian infrastructure. DAI Compute works
        with those initiatives to help inform the best ways to invest and deploy
        into Canadian energy and compute. Financial firms and other capital
        sources that want Canadian infrastructure exposure can use DAI Compute as
        where that capital is procured into real capacity.
      </p>
    </div>
  </section>

  <!-- The demonstration -->
  <section class="border-b border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
      <p class="field-label" style="color: var(--color-orange);">The thesis, visualized</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
        Centralised serves a few. Distributed builds sovereign capacity everywhere.
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate">
        Watch the two models alternate, or select one. Centralised compute
        concentrates in one location; distributed DAI Compute lights up nodes
        coast to coast, powered by Canadian energy, managed under Canadian law.
      </p>
      <div class="mt-10">
        <GridDemo />
      </div>
    </div>
  </section>

  <!-- Three paths -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
    <p class="field-label" style="color: var(--color-orange);">How capacity is procured</p>
    <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
      Invest. Buy. Build.
    </h2>
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      <div class="card-lift flex flex-col border border-hairline bg-ink-2/60 p-8">
        <span class="field-label" style="color: var(--color-orange);">Invest</span>
        <h3 class="mt-3 font-display text-2xl font-semibold text-snow">Capital into Canadian capacity.</h3>
        <p class="mt-4 text-sm leading-relaxed text-slate">
          Financial firms and infrastructure capital procure into Canadian energy
          and compute. Financial partners may offer financing or lease-to-own
          pathways for qualifying deployments. Register interest; no live rates
          are published.
        </p>
        <a href="/invest" class="accent-link field-note mt-6 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
          How investing works <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="card-lift flex flex-col border border-hairline bg-ink-2/60 p-8">
        <span class="field-label" style="color: var(--color-yellow);">Buy</span>
        <h3 class="mt-3 font-display text-2xl font-semibold text-snow">Sovereign compute and credits.</h3>
        <p class="mt-4 text-sm leading-relaxed text-slate">
          Purchase Canadian compute capacity and compute credits (prepaid usage
          credits for AI workloads) through conventional commercial contracts.
          Start with the workload and controls you need.
        </p>
        <a href="/buy" class="accent-link field-note mt-6 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]" style="color: var(--color-yellow);">
          How buying works <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="card-lift flex flex-col border border-hairline bg-ink-2/60 p-8">
        <span class="field-label" style="color: var(--color-red);">Build</span>
        <h3 class="mt-3 font-display text-2xl font-semibold text-snow">Host and expand capacity.</h3>
        <p class="mt-4 text-sm leading-relaxed text-slate">
          Qualifying sites and builders expand distributed energy and compute.
          Financial partners may assess financing or lease-to-own after
          feasibility. Capacity is managed by DAI Compute.
        </p>
        <a href="/build" class="accent-link field-note mt-6 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]" style="color: var(--color-red);">
          How building works <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why it holds -->
  <section class="border-t border-hairline bg-ink-2/30">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
      <p class="field-label" style="color: var(--color-orange);">Why it holds</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
        Canadian capacity, managed with care.
      </h2>
      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <FeatureCard kicker="Procurement" title="A clear place for capital">
          Infrastructure interest converts into energy and compute capacity
          through one procurement surface, not scattered foreign cloud alone.
        </FeatureCard>
        <FeatureCard kicker="Partners" title="Financing pathways">
          Financial partners may offer financing options or lease-to-own for
          qualifying deployments after feasibility and underwriting. Pathways
          under development; register interest.
        </FeatureCard>
        <FeatureCard kicker="Managed" title="Capacity under Canadian law" accent="red">
          Assets on Canadian soil, coordinated and managed by DAI Compute with
          qualified suppliers and operators. Residency is one part of a broader
          sovereignty assessment.
        </FeatureCard>
        <FeatureCard kicker="Complementary" title="Alongside the government">
          Private capital mobilised alongside federal sovereign-compute
          programmes, not against them.
        </FeatureCard>
      </div>
    </div>
  </section>

  <!-- Technology teaser -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10">
    <p class="field-label" style="color: var(--color-orange);">Optional path</p>
    <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
      Emerging technology, same Canadian capacity.
    </h2>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate">
      An optional blockchain financing and verification path is under
      development for the same physical outcome. It is not our public category
      identity. No token, deposit, or yield product is offered today.
    </p>
    <a href="/technology" class="accent-link field-note mt-7 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
      Read the technology path <span aria-hidden="true">&rarr;</span>
    </a>
  </section>

  <!-- The future teaser -->
  <section class="hero-glow relative overflow-hidden border-y border-hairline bg-ink-2/40">
    <div class="tech-grid absolute inset-0 opacity-70"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-24 lg:px-10">
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="field-label" style="color: var(--color-orange);">The long horizon</p>
          <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
            Capacity for the Canada that is arriving.
          </h2>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-mist">
            By 2080, up to 3.7 billion people may live outside the human climate
            niche. Canada sits in the temperature zone people will move toward.
            Sovereign energy and compute is settlement foundation for that
            future.
          </p>
          <a href="/future" class="accent-link field-note mt-7 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
            See the fifty-year trajectory <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="border border-hairline bg-ink-2 aspect-[4/3]">
          <ForesightScope
            client:only="react"
            theme="dark"
            showLegend={false}
            compact
            data={sovereigntyForesightData}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-6 py-24 text-center lg:px-10">
    <p class="field-label" style="color: var(--color-orange);">Join the first cohort</p>
    <h2 class="mx-auto mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow sm:text-4xl">
      Procure Canadian economic sovereignty.
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-slate">
      DAI Compute is pre-launch. Register your interest to invest, buy, build,
      or partner. No financial product is offered yet.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-5">
      <a href="/contact" class="btn-primary inline-flex items-center px-7 py-3.5 text-sm">Register interest</a>
      <a href="/technology" class="btn-ghost inline-flex items-center px-7 py-3.5 text-sm">Emerging technology path</a>
    </div>
  </section>
</Main>
