---
import Main from "@/layouts/Main.astro";
import PageHeader from "@/components/PageHeader.astro";
import StepCard from "@/components/StepCard.astro";
import FeatureCard from "@/components/FeatureCard.astro";
---

<Main
  title="Invest: Procure into Canadian energy and compute"
  description="DAI Compute is the procurement place for capital seeking Canadian energy and AI compute capacity. Financial partners may offer financing or lease-to-own pathways. Register interest."
  activePath="/invest"
>
  <PageHeader
    eyebrow="Invest"
    title="Procure capital into Canadian energy and compute."
    lede="Financial firms and other sources that want Canadian infrastructure exposure use DAI Compute as the procurement place. We work with initiatives such as Canada2080 to help inform how to invest and deploy. Financial partners may offer financing or lease-to-own pathways for qualifying deployments."
  />

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <p class="field-label" style="color: var(--color-orange);">How it works</p>
    <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
      From infrastructure interest to managed capacity.
    </h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <StepCard index="01" title="Inform invest and deploy">
        Initiatives such as
        <a href="https://canada2080.org" class="accent-link">Canada2080</a>
        rally interest in Canadian infrastructure. DAI Compute helps translate
        that interest into energy and compute deployment choices.
      </StepCard>
      <StepCard index="02" title="Procure through DAI Compute">
        Capital is directed into Canadian energy and compute capacity coordinated
        by DAI Compute, not scattered solely across foreign-owned cloud.
      </StepCard>
      <StepCard index="03" title="Partner financing pathways">
        Independent financial partners may assess financing options or
        lease-to-own structures after feasibility and underwriting. Approval,
        rates, and terms are partner- and transaction-specific. DAI Compute does
        not currently offer financing as a live product.
      </StepCard>
    </div>
  </section>

  <section class="border-y border-hairline bg-ink-2/30">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="field-label" style="color: var(--color-orange);">Who this is for</p>
      <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
        Infrastructure capital, not speculation.
      </h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <FeatureCard kicker="Financial firms" title="Canadian infrastructure exposure">
          Seek durable energy and compute capacity under Canadian law. Use DAI
          Compute as where that exposure is procured into real assets.
        </FeatureCard>
        <FeatureCard kicker="Financial partners" title="Financing and lease-to-own">
          Partners may evaluate financing or lease-to-own for solar, battery,
          and compute deployments after site and commercial diligence.
        </FeatureCard>
        <FeatureCard kicker="Mission capital" title="Aligned with Canada2080">
          Patient capital that wants Canadian capability compounding at home can
          register interest for the first cohort of deployments.
        </FeatureCard>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <div class="max-w-3xl">
      <p class="field-label" style="color: var(--color-orange);">Where we are</p>
      <h2 class="mt-4 font-display text-2xl font-semibold leading-tight tracking-tight text-snow sm:text-3xl">
        Pathways under development. Register interest.
      </h2>
      <p class="mt-5 text-base leading-relaxed text-slate">
        No rates, yields, or deposit products are published. An optional
        emerging-technology financing path is described under
        <a href="/technology" class="accent-link">Technology</a>; traditional
        partner financing leads. This is not investment advice.
      </p>
      <a href="/contact" class="btn-primary mt-8 inline-flex items-center px-7 py-3.5 text-sm">
        Register interest
      </a>
    </div>
  </section>
</Main>
