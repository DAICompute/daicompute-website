---
import Main from "@/layouts/Main.astro";
import PageHeader from "@/components/PageHeader.astro";

const team = [
  { name: "Francis Wang", role: "Founder", note: "Over a decade in renewable energy software; patent holder in distributed energy management. Doctoral research in long-term innovation, applying futures research and strategic foresight." },
  { name: "William Yao", role: "Financial governance", note: "Four decades of financial governance and network, including Merrill Lynch." },
];
---

<Main
  title="About: Procuring and managing Canadian sovereign compute"
  description="DAI Compute is the procurement place for Canadian energy and AI compute capacity. Traditional partner financing leads. Capacity managed by DAI Compute."
  activePath="/about"
>
  <PageHeader
    eyebrow="About"
    title="Built by the disciplines this problem requires."
    lede="DAI Compute is the procurement place for Canadian energy and AI compute capacity, and the first vehicle in a programme called Sovereign Energy and AI Infrastructure Canada."
  />

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="field-label" style="color: var(--color-orange);">Why us</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
          Procurement, capacity, and financial governance.
        </h2>
        <div class="mt-6 space-y-4 text-base leading-relaxed text-slate">
          <p>
            The founding pair combines renewable energy software and distributed
            energy management, futures research and strategic foresight, and four
            decades of financial governance and network.
          </p>
          <p>
            We work with initiatives such as
            <a href="https://canada2080.org" class="accent-link">Canada2080</a>
            to help inform how capital invests and deploys into Canadian energy
            and compute. Capacity is managed by DAI Compute with qualified
            suppliers and operators. Affiliated companies are not named as
            public partners on this site.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-hairline bg-ink-2/30">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="field-label" style="color: var(--color-orange);">The founders</p>
      <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-tight text-snow">
        Energy and foresight, meet financial governance.
      </h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {
          team.map((m) => (
            <div class="border border-hairline bg-ink-2/60 p-6">
              <h3 class="font-display text-lg font-semibold text-snow">{m.name}</h3>
              <p class="field-label mt-1" style="color: var(--color-orange);">{m.role}</p>
              <p class="mt-3 text-sm leading-relaxed text-slate">{m.note}</p>
            </div>
          ))
        }
      </div>
      <p class="field-note mt-6 text-slate/60">
        Public attribution confirmed for the founding pair; additional team detail withheld pre-launch.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <div class="max-w-3xl">
      <p class="field-label" style="color: var(--color-orange);">Origin</p>
      <h2 class="mt-4 font-display text-2xl font-semibold leading-tight tracking-tight text-snow sm:text-3xl">
        It started with a dependence problem.
      </h2>
      <p class="mt-5 text-base leading-relaxed text-slate">
        DAI Compute began with a problem Francis Wang kept running into: Canada
        is structurally dependent on foreign-operated infrastructure for much of
        its AI economy. Even data centres on Canadian soil can raise control and
        jurisdiction questions when the operating entity is foreign-linked.
      </p>
      <p class="mt-4 text-base leading-relaxed text-slate">
        The response is a procurement and capacity platform that lets Canadians
        finance (through financial partners) and buy energy and compute on
        Canadian soil under Canadian law, with capacity managed by DAI Compute.
      </p>
      <a href="/sovereignty" class="accent-link field-note mt-6 inline-flex w-fit items-center gap-1.5 uppercase tracking-[0.16em]">
        The problem we solve <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center lg:px-10">
      <h2 class="mx-auto max-w-2xl font-display text-2xl font-semibold leading-tight tracking-tight text-snow sm:text-3xl">
        Want to build this with us?
      </h2>
      <a href="/contact" class="btn-primary mt-8 inline-flex items-center px-7 py-3.5 text-sm">
        Start a conversation
      </a>
    </div>
  </section>
</Main>
